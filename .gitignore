# ---------------------------------------------------------------------------
# Isolation Clock — .gitignore (Vite + React + TypeScript, static deploy)
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
dist-ssr/
*.local

# Vite
.vite/
.vite-cache/

# Environment / secrets
.env
.env.*
!.env.example

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# Testing / coverage
coverage/
.nyc_output/

# Python bytecode (the offline scripts are run, not imported)
__pycache__/
*.pyc

# Python virtualenv for the offline pipeline (see requirements.txt)
.venv/
venv/

# AI browser-tool session artifacts: console logs, page snapshots, storage state
.playwright-mcp/
state/

# Deploy platforms
.vercel/
.netlify/

# TypeScript build info
*.tsbuildinfo

# Large / raw geospatial inputs (source data, not the served JSON)
data/raw/
data/**/*.osm
data/**/*.pbf
data/**/*.tif
data/**/*.tiff
data/**/*.gpkg
data/**/*.shp
data/**/*.shx
data/**/*.dbf
data/**/*.prj

# Keep the app-facing precomputed JSON that ships with the static build
!public/data/*.json
